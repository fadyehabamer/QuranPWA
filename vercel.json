{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/js/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/data/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quran",
      "destination": "/quran.html"
    },
    {
      "source": "/azkar",
      "destination": "/azkar.html"
    },
    {
      "source": "/masbaha",
      "destination": "/masbaha.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/bookmarks",
      "destination": "/bookmarks.html"
    },
    {
      "source": "/sunan",
      "destination": "/sunan.html"
    },
    {
      "source": "/prayer-times",
      "destination": "/prayer-times.html"
    },
    {
      "source": "/bio",
      "destination": "/bio.html"
    }
  ]
}
