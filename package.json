{
    "name": "quranpwa",
    "version": "1.0.0",
    "description": "Quran Progressive Web App",
    "scripts": {
        "deploy": "vercel deploy --force --prod",
        "dev": "vercel dev",
        "download:mushaf": "node scripts/download-mushaf-pages.js",
        "build:www": "node scripts/build-www.js",
        "cap:sync": "npm run build:www && cap sync",
        "cap:ios": "npm run build:www && cap sync ios && cap open ios",
        "cap:android": "npm run build:www && cap sync android && cap open android",
        "cap:run:ios": "npm run build:www && cap run ios",
        "cap:run:android": "npm run build:www && cap run android"
    },
    "keywords": [],
    "author": "Fady Ehab Amer",
    "license": "MIT",
    "dependencies": {
        "@capacitor/android": "^8.3.3",
        "@capacitor/app": "^8.1.0",
        "@capacitor/cli": "^8.3.3",
        "@capacitor/core": "^8.3.3",
        "@capacitor/haptics": "^8.0.2",
        "@capacitor/ios": "^8.3.3",
        "@capacitor/local-notifications": "^8.1.0",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.1",
        "@capacitor/status-bar": "^8.0.2",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5"
    }
}
