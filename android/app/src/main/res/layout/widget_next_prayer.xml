<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_prayer_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الصلاة القادمة"
        android:textColor="#FFD479"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layoutDirection="rtl" />

    <TextView
        android:id="@+id/widget_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:layoutDirection="rtl"
        tools:text="الفجر"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginTop="2dp"
        tools:text="04:48"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_prayer_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E0E8C2"
        android:textSize="13sp"
        tools:text="بعد 1 س 12 د"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/widget_prayer_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#A6C4A8"
        android:textSize="11sp"
        tools:text="القاهرة"
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>
