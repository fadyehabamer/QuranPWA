<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_ayah_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="آية اليوم"
        android:textColor="#FFD479"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_ayah_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textAlignment="viewEnd"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end"
        tools:text="إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا" />

    <TextView
        android:id="@+id/widget_ayah_reference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E0E8C2"
        android:textSize="12sp"
        tools:text="الشرح : 6" />
</LinearLayout>
